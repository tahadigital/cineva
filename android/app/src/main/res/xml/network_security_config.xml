<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Store APIs, auth endpoints, and public metadata must strictly use HTTPS. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">themoviedb.org</domain>
        <domain includeSubdomains="true">tmdb.org</domain>
        <domain includeSubdomains="true">cineva.app</domain>
        <domain includeSubdomains="true">blender.org</domain>
    </domain-config>
    <!-- Local LAN media servers and user-provided stream hosts may require HTTP unless upgraded by provider. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
